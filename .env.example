# ─────────────────────────────────────────────────────────────────────────────
#  Toast Notification — Self-Hosted Configuration
#  Copy this file to .env and fill in the required values before running
#  docker compose up -d.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# Password for the internal PostgreSQL container.
# Use a strong random value. This is the only password you need to set.
POSTGRES_PASSWORD=changeme_use_a_strong_password


# ── JWT Secret ────────────────────────────────────────────────────────────────
# Signs all authentication tokens. Must be at least 32 characters.
# Generate a secure value:  openssl rand -base64 32
JWT_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET


# ── Public URL ────────────────────────────────────────────────────────────────
# The URL your users will access the dashboard from. No trailing slash.
# Used for CORS and email links.
# Examples:
#   http://192.168.1.100        (LAN access, no DNS)
#   https://toast.yourcompany.com  (behind your reverse proxy with TLS)
PUBLIC_URL=http://localhost


# ── Registration ──────────────────────────────────────────────────────────────
# Email address that receives trial approval requests when a new tenant registers.
# This admin then approves or rejects via the dashboard.
REVIEW_EMAIL=admin@yourcompany.com

# How many days a new trial tenant can use the platform before requiring upgrade.
TRIAL_DAYS=14


# ── Billing Gate ──────────────────────────────────────────────────────────────
# Set to true only for managed SaaS deployments where Stripe is configured.
# When false (default), device registration is unlimited — no Stripe subscription
# required. Self-hosted deployments should leave this unset or false.
TOAST_REQUIRE_BILLING=false


# ── Cloudflare Turnstile (optional) ───────────────────────────────────────────
# Bot protection on the public registration page.
# Set TURNSTILE_REQUIRED=false to skip entirely — recommended for internal
# or private deployments where you control who reaches the registration page.
# If enabled, create a Turnstile widget at dash.cloudflare.com and paste keys below.
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Azure Content Safety (optional) ───────────────────────────────────────────
# AI-backed moderation of notification content before delivery.
# If these are left empty, the moderation service degrades gracefully —
# all notification content passes without being scanned. Safe to leave blank.
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=


# ── Email — Mailjet (configured post-install) ─────────────────────────────────
# Used for registration magic links, password reset, and SMS MFA fallback.
# You can set these here or configure them later via the admin dashboard
# at Settings > Messaging.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_SENDER_EMAIL=no-reply@yourcompany.com


# ── SMS — ClickSend (configured post-install) ─────────────────────────────────
# Used for SMS MFA during registration and login. Optional — users can use
# TOTP (authenticator app) as an alternative.
# Configure via the admin dashboard at Settings > Messaging.
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=
