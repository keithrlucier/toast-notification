[Unit]
Description=Toast Notification — pg_dump of toastrevival
Documentation=https://github.com/keithrlucier/toast/blob/main/Docs/ToastRevival/CONTEXT.md
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/bin/toast-pg-backup.sh
SyslogIdentifier=toast-pg-backup
# Sandboxing — the script only needs to read pg cluster files (via local socket)
# and write to /opt/toast/backups. Lock the rest down.
ProtectSystem=strict
ReadWritePaths=/opt/toast/backups
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
