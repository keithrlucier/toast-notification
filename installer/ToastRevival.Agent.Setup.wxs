<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Toast Notification Agent"
      Manufacturer="Toast2IT, LLC"
      Version="$(var.ProductVersion)"
      UpgradeCode="A6F3D8F1-7B22-4E5A-9E3C-2A4F8B1C9D70"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="Toast Notification Agent installer" />

    <!-- EULA dialog (WixUI_Minimal: one screen with license acceptance). -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!--
      INFO-M2C-002: OS floor enforcement. Windows 10 build 19041 (2004, May 2020)
      is the minimum supported version — WinUI 3 and AppNotificationManager require
      it. VersionNT64 is the 64-bit OS version in MMNN format; 19041 decimal.
      This prevents the agent from being silently installed on unsupported OS
      versions and exiting at runtime with code 2.
    -->
    <!--
      VersionNT64 is major*100+minor: Windows 10/11 = 1000. This catches pre-Win10
      (7=601, 8.1=603). Precise build-19041 floor is enforced at runtime by Program.cs.
    -->
    <Launch Condition="VersionNT64 &gt;= 1000" Message="Toast Notification Agent requires Windows 10 or later." />

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Toast Notification" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="Toast Notification" />
    </StandardDirectory>

    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="LogonTaskAssets" Directory="INSTALLFOLDER">
      <Component Id="LogonTaskXml" Guid="78C12E0A-1F86-4D72-8B53-9F4D0A6E1C88">
        <File Id="ToastNotificationLogonXml"
              Source="$(var.LogonTaskXmlPath)"
              Name="ToastNotificationLogon.xml"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder" Guid="2D1A8E37-B7F0-4F4B-AE5C-71E2A9D6CA42">
        <Shortcut Id="StartMenuAgentShortcut"
                  Name="Toast Notification"
                  Target="[INSTALLFOLDER]ToastNotification.Agent.exe"
                  Arguments="--template alert --no-wait"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Run the Toast Notification agent (alert toast)." />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU"
                       Key="Software\Toast2IT\Toast Notification\Install"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      MSI public properties for silent RMM deployment.

      Usage:
        msiexec /i ToastNotification.Agent.msi /qn CLIENTID=<tenant-guid> SERVERURL=https://api.example.com

      When both are provided, the WriteBootstrapJson custom action calls the agent
      exe in setup-bootstrap mode to write %ProgramFiles%\Toast Notification\bootstrap.json.
      The agent reads bootstrap.json on first launch to register with the backend without
      requiring environment variables on the endpoint.

      These properties are OPTIONAL — an MSP can omit them and configure bootstrap.json
      via other means (GPO preference, RMM file deployment, manual placement).
    -->
    <Property Id="CLIENTID" />
    <Property Id="SERVERURL" />
    <!--
      Optional pre-shared enrollment key (INFO-M1-003). When the backend tenant
      has an EnrollmentKey set, this must match or device registration is rejected.
      Pass via: msiexec /i ... /qn CLIENTID=... SERVERURL=... ENROLLMENTKEY=...
    -->
    <Property Id="ENROLLMENTKEY" />

    <Feature Id="Main" Title="Toast Notification Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentGroupRef Id="LogonTaskAssets" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!--
      Scheduled Task plumbing.

      Replaces the M0A Startup-folder shortcut with a logon-triggered Scheduled Task
      registered under \Toast2IT\ToastNotificationAgentLogon. The task runs in the
      logged-on user's context (group principal BUILTIN\Users, RunLevel=LeastPrivilege)
      because Windows App SDK toast notifications hard-fail under elevated/admin
      processes (see Program.cs:17-22). Better GPO and Intune compatibility than the
      per-machine Startup folder.

      The schtasks.exe Create/Delete invocations run as deferred custom actions in the
      install/uninstall script, executing as SYSTEM (Impersonate="no") because
      registering a per-user-group task requires the privilege.

      Uninstall returns "ignore" so a missing-task error on uninstall (e.g., a user
      manually removed the task before uninstalling the MSI) does not break removal.
    -->
    <CustomAction Id="InstallScheduledTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Create /TN &quot;\Toast2IT\ToastNotificationAgentLogon&quot; /XML &quot;[INSTALLFOLDER]ToastNotificationLogon.xml&quot; /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="UninstallScheduledTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;\Toast2IT\ToastNotificationAgentLogon&quot; /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      D9: Write bootstrap.json next to the exe using the agent's own setup-bootstrap
      mode (XML comments cannot contain the literal CLI double-dash; the actual flag
      is on the ExeCommand attribute below). Runs before InstallScheduledTask so the
      task fires into a pre-configured agent at first logon. Conditioned on both
      CLIENTID and SERVERURL being provided; if either is empty the step is skipped
      and the MSP must drop bootstrap.json through another channel.

      [CLIENTID] and [SERVERURL] are resolved from MSI properties in the immediate
      phase when the install script is built — deferred CAs see the expanded values
      in the ExeCommand string at execution time.
    -->
    <CustomAction Id="WriteBootstrapJson"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]ToastNotification.Agent.exe&quot; --setup-bootstrap [CLIENTID] &quot;[SERVERURL]&quot; [ENROLLMENTKEY]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      D9 uninstall: delete bootstrap.json. Return="ignore" — a missing file
      (e.g. agent already ran and registered, or never bootstrapped) must not
      block removal.
    -->
    <CustomAction Id="DeleteBootstrapJson"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c del /f /q &quot;[INSTALLFOLDER]bootstrap.json&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Write bootstrap.json first; schedule task fires into a configured agent. -->
      <Custom Action="WriteBootstrapJson"   After="InstallFiles"        Condition="NOT REMOVE AND CLIENTID &lt;&gt; &quot;&quot; AND SERVERURL &lt;&gt; &quot;&quot;" />
      <Custom Action="InstallScheduledTask" After="WriteBootstrapJson"  Condition="NOT REMOVE" />
      <Custom Action="UninstallScheduledTask" Before="DeleteBootstrapJson" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="DeleteBootstrapJson"  Before="RemoveFiles"        Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
