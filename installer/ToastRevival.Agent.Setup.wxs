<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="ToastRevival Agent"
      Manufacturer="TOAST2IT LLC"
      Version="$(var.ProductVersion)"
      UpgradeCode="A6F3D8F1-7B22-4E5A-9E3C-2A4F8B1C9D70"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="ToastRevival Agent - M0A spike installer" />

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ToastRevival" />
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="ToastRevival" />
    </StandardDirectory>

    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartupShortcut" Directory="StartupFolder" Guid="C9C0F2A3-1D44-4E97-9B40-5C2F8AD93A11">
        <Shortcut Id="StartupAgentShortcut"
                  Name="ToastRevival Agent"
                  Target="[INSTALLFOLDER]ToastRevival.Agent.exe"
                  Arguments="--template alert --no-wait"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Fires the ToastRevival M0A alert toast at login." />
        <RegistryValue Root="HKMU"
                       Key="Software\TOAST2IT\ToastRevival\Install"
                       Name="StartupShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder" Guid="2D1A8E37-B7F0-4F4B-AE5C-71E2A9D6CA42">
        <Shortcut Id="StartMenuAgentShortcut"
                  Name="ToastRevival Agent"
                  Target="[INSTALLFOLDER]ToastRevival.Agent.exe"
                  Arguments="--template alert --no-wait"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Run the ToastRevival M0A agent (alert toast)." />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU"
                       Key="Software\TOAST2IT\ToastRevival\Install"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="ToastRevival Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

  </Package>
</Wix>
