<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Process-wide DPI awareness. Pairs with the WinForms
         Application.SetHighDpiMode(PerMonitorV2) call in TrayIconService. The
         project property makes WinForms emit a manifest fragment that takes
         effect at process boot — before any GDI call — so DesktopOverlayService
         renders its bitmap at native pixel size on >100% scale displays
         instead of getting bilinearly upscaled by the OS. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ToastRevival.Agent</RootNamespace>
    <AssemblyName>ToastNotification.Agent</AssemblyName>
    <ApplicationIcon>ToastNotification.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.39</Version>
    <AssemblyVersion>0.4.39</AssemblyVersion>
    <FileVersion>0.4.39</FileVersion>
    <!-- AssemblyTitle / Product / Company / Description populate the exe's
         version-info resource fields that Task Manager, File Properties, and
         the WinAppSDK auto-derived AUMID DisplayName fallback all read from.
         Without these the defaults leak AssemblyName ("ToastNotification.Agent")
         into user-visible surfaces. -->
    <AssemblyTitle>Toast Notification</AssemblyTitle>
    <Product>Toast Notification</Product>
    <Company>Toast2IT, LLC</Company>
    <Description>Managed Windows toast notifications for MSP-administered endpoints.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxBundle>Never</AppxBundle>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250310001" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
